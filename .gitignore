# Secrets. The Mistral key lives in .env and must never reach a commit --
# a key in git history stays there after deletion and has to be rotated.
.env
.env.*
!.env.example

# Frontend dependencies. web/dist IS committed -- it is the deployable
# artifact and the reason the service is one process rather than two.
web/node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Generator scratch. tests/test_invariants.py writes this on every run and
# never cleans it up; it is a byte-comparison target, not data.
data/_determinism_check/

# NOT ignored, deliberately:
#   cache/explanations/seed99/  was excluded while seed 99 was sealed and the
#                         README called it unscored. It was scored on 30 Aug
#                         and the result is published, so the cache that makes
#                         its queue render offline ships with it.
#   cache/explanations/   committed on purpose, so the hosted demo makes zero
#                         API calls -- no quota burn, no rate limit mid-review
#   data/seed42/          the development dataset is the artefact
#   data/seed99/          the held-out dataset must ship to be checkable
